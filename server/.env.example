# Sao chép file này thành server/.env rồi điền giá trị thật.
# server/.env đã được .gitignore — KHÔNG commit key lên GitHub.
# Không điền SMTP_* → email chạy chế độ dev (chỉ log ra console, không gửi thật).

# --- SMTP gửi email nhắc/quá hạn ---
# Ví dụ Gmail (cần bật 2FA rồi tạo "App password" tại https://myaccount.google.com/apppasswords):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# URL frontend, dùng cho link trong mã QR (mặc định http://localhost:5173)
APP_URL=http://localhost:5173

# --- (tuỳ chọn) override khác ---
# PORT=5555
# JWT_ACCESS_SECRET=doi-thanh-chuoi-bi-mat-cua-ban
# LOAN_DAYS=14
# FINE_PER_DAY=5000
